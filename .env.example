# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA FORENSE CONSTITUCIONAL DE IA
# Copia este archivo como .env para desarrollo local o configúralo en el panel de Render.
# ==============================================================================

# Llave de API de Groq para análisis en la nube
GROQ_API_KEY=tu_llave_de_groq_aqui

# Puerto de ejecución (en Render se asigna automáticamente mediante $PORT)
PORT=8000

# Configuración opcional de correo SMTP para autenticación de dos factores (OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_password_de_aplicacion
