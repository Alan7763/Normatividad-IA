# ==============================================================================
# .gitignore - Sistema Forense Constitucional de Normatividad en IA
# ==============================================================================

# Entorno virtual y dependencias Python
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/

# Archivos de caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Archivos sensibles, secretos y llaves de API (NUNCA subir a GitHub)
api
.env
*.env
*.key
*.pem
secrets.json

# Base de datos local SQLite (se inicializa automáticamente al arrancar la app)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
normatividad_ia.db

# Paquetes y cachés de Node.js
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de sistema operativo y editores de código
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Archivos temporales de pruebas y respaldos
_temp*
test_*
*.tmp
*.bak
*.log
.user_uploaded/
